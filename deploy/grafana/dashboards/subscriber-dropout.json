{
 "uid": "subscriber-dropout",
 "title": "Subscriber Dropout \u2014 Model Health",
 "tags": [
  "mlops",
  "subscriber-dropout"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 4,
 "refresh": "30s",
 "time": {
  "from": "now-24h",
  "to": "now"
 },
 "panels": [
  {
   "type": "row",
   "title": "Is it up, and what is it serving?",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 1
   }
  },
  {
   "type": "stat",
   "title": "Model loaded",
   "description": "0 means the API is live but cannot score anyone \u2014 /predict returns 503.",
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "expr": "subscriber_model_loaded{job=\"subscriber-api\"}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "NO MODEL",
         "color": "red",
         "index": 0
        }
       }
      },
      {
       "type": "value",
       "options": {
        "1": {
         "text": "LOADED",
         "color": "green",
         "index": 1
        }
       }
      }
     ],
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 1
       }
      ]
     }
    }
   }
  },
  {
   "type": "stat",
   "title": "Served from",
   "description": "'registry' means the promotion gate controls what is live. 'local' means it is reading a file on disk.",
   "gridPos": {
    "x": 4,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "expr": "subscriber_model_served_from{job=\"subscriber-api\"} == 1",
     "legendFormat": "{{source}}",
     "refId": "A"
    }
   ],
   "options": {
    "textMode": "name",
    "colorMode": "background"
   }
  },
  {
   "type": "stat",
   "title": "Decision threshold",
   "description": "Tuned during training, not fixed at 0.5. Predictions at or above this are flagged.",
   "gridPos": {
    "x": 8,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "expr": "subscriber_decision_threshold{job=\"subscriber-api\"}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "decimals": 2
    }
   }
  },
  {
   "type": "stat",
   "title": "Flagged rate",
   "description": "Share of scored subscribers above the threshold. Training base rate is ~20%.",
   "gridPos": {
    "x": 12,
    "y": 1,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "expr": "subscriber_flagged_rate{job=\"subscriber-api\"}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "yellow",
        "value": 0.35
       },
       {
        "color": "red",
        "value": 0.5
       }
      ]
     }
    }
   }
  },
  {
   "type": "stat",
   "title": "Score shift vs training",
   "description": "Live mean probability minus the training-time mean. Moves when behaviour changes, deploy or no deploy.",
   "gridPos": {
    "x": 18,
    "y": 1,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "expr": "subscriber_probability_mean_shift{job=\"subscriber-api\"}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "decimals": 3,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "yellow",
        "value": 0.1
       },
       {
        "color": "red",
        "value": 0.15
       }
      ]
     }
    }
   }
  },
  {
   "type": "row",
   "title": "Prediction traffic",
   "gridPos": {
    "x": 0,
    "y": 5,
    "w": 24,
    "h": 1
   }
  },
  {
   "type": "timeseries",
   "title": "Predictions per second, by risk band",
   "gridPos": {
    "x": 0,
    "y": 6,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "expr": "sum by (risk_level) (rate(subscriber_predictions_total[5m]))",
     "legendFormat": "{{risk_level}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "fillOpacity": 20,
      "stacking": {
       "mode": "normal"
      }
     }
    }
   }
  },
  {
   "type": "timeseries",
   "title": "Score distribution (median / p90 / p99)",
   "description": "Quantiles over the probability histogram. A rising p90 with a flat median means the tail is moving, not the whole population.",
   "gridPos": {
    "x": 12,
    "y": 6,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.5, sum(rate(subscriber_prediction_probability_bucket[5m])) by (le))",
     "legendFormat": "p50",
     "refId": "A"
    },
    {
     "expr": "histogram_quantile(0.9, sum(rate(subscriber_prediction_probability_bucket[5m])) by (le))",
     "legendFormat": "p90",
     "refId": "B"
    },
    {
     "expr": "histogram_quantile(0.99, sum(rate(subscriber_prediction_probability_bucket[5m])) by (le))",
     "legendFormat": "p99",
     "refId": "C"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "max": 1,
     "min": 0
    }
   }
  },
  {
   "type": "timeseries",
   "title": "Streaming throughput (scorer + API)",
   "description": "The stream scorer serves its own metrics on :8001, scraped as a separate job so a dead consumer is not hidden by a healthy API.",
   "gridPos": {
    "x": 0,
    "y": 14,
    "w": 24,
    "h": 6
   },
   "targets": [
    {
     "expr": "sum by (component) (rate(subscriber_predictions_total[5m]))",
     "legendFormat": "{{component}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "fillOpacity": 15
     }
    }
   }
  },
  {
   "type": "row",
   "title": "Drift and the retraining pipeline",
   "gridPos": {
    "x": 0,
    "y": 20,
    "w": 24,
    "h": 1
   }
  },
  {
   "type": "stat",
   "title": "Drift verdict",
   "description": "From the last pipeline run. 0 stable \u00b7 1 moderate \u00b7 2 significant.",
   "gridPos": {
    "x": 0,
    "y": 21,
    "w": 5,
    "h": 5
   },
   "targets": [
    {
     "expr": "subscriber_drift_verdict{job=\"subscriber-api\"}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "STABLE",
         "color": "green",
         "index": 0
        },
        "1": {
         "text": "MODERATE",
         "color": "yellow",
         "index": 1
        },
        "2": {
         "text": "SIGNIFICANT",
         "color": "red",
         "index": 2
        }
       }
      }
     ],
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "yellow",
        "value": 1
       },
       {
        "color": "red",
        "value": 2
       }
      ]
     }
    }
   },
   "options": {
    "colorMode": "background"
   }
  },
  {
   "type": "bargauge",
   "title": "PSI by feature",
   "description": "Which inputs actually moved. Bands: <0.10 stable, 0.10\u20130.25 moderate, >0.25 significant.",
   "gridPos": {
    "x": 5,
    "y": 21,
    "w": 11,
    "h": 10
   },
   "targets": [
    {
     "expr": "subscriber_drift_psi{job=\"subscriber-api\"}",
     "legendFormat": "{{feature}}",
     "refId": "A"
    }
   ],
   "options": {
    "orientation": "horizontal",
    "displayMode": "gradient"
   },
   "fieldConfig": {
    "defaults": {
     "decimals": 3,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "yellow",
        "value": 0.1
       },
       {
        "color": "red",
        "value": 0.25
       }
      ]
     }
    }
   }
  },
  {
   "type": "stat",
   "title": "Last pipeline run",
   "description": "A silent scheduler is worse than a failing one: the model ages while everything looks green.",
   "gridPos": {
    "x": 16,
    "y": 21,
    "w": 4,
    "h": 5
   },
   "targets": [
    {
     "expr": "time() - subscriber_pipeline_last_run_timestamp_seconds{job=\"subscriber-api\"}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "yellow",
        "value": 93600
       },
       {
        "color": "red",
        "value": 129600
       }
      ]
     }
    }
   }
  },
  {
   "type": "stat",
   "title": "Last promotion",
   "description": "A rejected challenger is the gate working, not a failure.",
   "gridPos": {
    "x": 20,
    "y": 21,
    "w": 4,
    "h": 5
   },
   "targets": [
    {
     "expr": "subscriber_pipeline_promoted{job=\"subscriber-api\"}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "REJECTED",
         "color": "yellow",
         "index": 0
        },
        "1": {
         "text": "PROMOTED",
         "color": "green",
         "index": 1
        }
       }
      },
      {
       "type": "special",
       "options": {
        "match": "nan",
        "result": {
         "text": "NOT RUN",
         "color": "text",
         "index": 1
        }
       }
      },
      {
       "type": "special",
       "options": {
        "match": "null",
        "result": {
         "text": "NOT RUN",
         "color": "text",
         "index": 2
        }
       }
      }
     ]
    }
   },
   "options": {
    "colorMode": "background",
    "reduceOptions": {
     "calcs": [
      "last"
     ],
     "fields": "",
     "values": false
    }
   }
  },
  {
   "type": "stat",
   "title": "Needs attention",
   "gridPos": {
    "x": 0,
    "y": 26,
    "w": 5,
    "h": 5
   },
   "targets": [
    {
     "expr": "subscriber_pipeline_needs_attention{job=\"subscriber-api\"}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "CLEAR",
         "color": "green",
         "index": 0
        },
        "1": {
         "text": "REVIEW",
         "color": "orange",
         "index": 1
        }
       }
      }
     ]
    }
   },
   "options": {
    "colorMode": "background"
   }
  },
  {
   "type": "stat",
   "title": "Drift sample size",
   "description": "PSI below a few hundred rows is sampling noise; the pipeline reports whether the batch was large enough to trust.",
   "gridPos": {
    "x": 16,
    "y": 26,
    "w": 8,
    "h": 5
   },
   "targets": [
    {
     "expr": "subscriber_drift_sample_size{job=\"subscriber-api\"}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "decimals": 0,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 100
       }
      ]
     }
    }
   }
  },
  {
   "type": "timeseries",
   "title": "Drift verdict over time",
   "description": "The reason Prometheus exists here: the in-process /metrics window forgets everything on restart.",
   "gridPos": {
    "x": 0,
    "y": 31,
    "w": 24,
    "h": 5
   },
   "targets": [
    {
     "expr": "subscriber_drift_verdict{job=\"subscriber-api\"}",
     "legendFormat": "verdict",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "max": 2,
     "min": 0,
     "custom": {
      "fillOpacity": 15,
      "lineInterpolation": "stepAfter"
     }
    }
   }
  },
  {
   "type": "row",
   "title": "Decision quality \u2014 is the model fit for the decision it drives?",
   "gridPos": {
    "x": 0,
    "y": 36,
    "w": 24,
    "h": 1
   }
  },
  {
   "type": "stat",
   "title": "Fairness audit",
   "description": "Does the model work equally well across groups? A selection-rate gap may be correct; a recall or AUC gap is far harder to justify.",
   "gridPos": {
    "x": 0,
    "y": 37,
    "w": 5,
    "h": 5
   },
   "targets": [
    {
     "expr": "subscriber_model_fairness_passes{job=\"subscriber-api\"}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "DISPARITY",
         "color": "orange",
         "index": 0
        },
        "1": {
         "text": "PASSES",
         "color": "green",
         "index": 1
        }
       }
      }
     ]
    }
   },
   "options": {
    "colorMode": "background"
   }
  },
  {
   "type": "bargauge",
   "title": "Group disparity ratios",
   "description": "Worst-to-best group ratio per metric. Below 0.8 (the four-fifths convention) is a prompt to look, never a verdict.",
   "gridPos": {
    "x": 5,
    "y": 37,
    "w": 11,
    "h": 5
   },
   "targets": [
    {
     "expr": "subscriber_model_fairness_ratio{job=\"subscriber-api\"}",
     "legendFormat": "{{metric}}",
     "refId": "A"
    }
   ],
   "options": {
    "orientation": "horizontal",
    "displayMode": "gradient"
   },
   "fieldConfig": {
    "defaults": {
     "max": 1,
     "min": 0,
     "decimals": 3,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 0.8
       }
      ]
     }
    }
   }
  },
  {
   "type": "stat",
   "title": "Calibration error",
   "description": "ECE: when the model says 0.7, does 70% of that group actually churn? Only matters because probabilities are multiplied by money.",
   "gridPos": {
    "x": 16,
    "y": 37,
    "w": 4,
    "h": 5
   },
   "targets": [
    {
     "expr": "subscriber_model_calibration_ece{job=\"subscriber-api\"}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "decimals": 4,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "yellow",
        "value": 0.05
       },
       {
        "color": "red",
        "value": 0.1
       }
      ]
     }
    }
   }
  },
  {
   "type": "stat",
   "title": "Savings left on the table",
   "description": "What the cost-optimal threshold would save versus the one in use, on the test split.",
   "gridPos": {
    "x": 20,
    "y": 37,
    "w": 4,
    "h": 5
   },
   "targets": [
    {
     "expr": "subscriber_model_cost_savings_available{job=\"subscriber-api\"}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "decimals": 0
    }
   }
  },
  {
   "type": "row",
   "title": "Shadow scoring \u2014 the challenger on live traffic",
   "gridPos": {
    "x": 0,
    "y": 42,
    "w": 24,
    "h": 1
   }
  },
  {
   "type": "stat",
   "title": "Shadow active",
   "description": "1 when a distinct challenger is scoring live traffic without serving it.",
   "gridPos": {
    "x": 0,
    "y": 43,
    "w": 4,
    "h": 5
   },
   "targets": [
    {
     "expr": "subscriber_shadow_active{job=\"subscriber-api\"}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "IDLE",
         "color": "text",
         "index": 0
        },
        "1": {
         "text": "SHADOWING",
         "color": "blue",
         "index": 1
        }
       }
      }
     ]
    }
   },
   "options": {
    "colorMode": "background"
   }
  },
  {
   "type": "stat",
   "title": "Agreement rate",
   "description": "Share of requests where both models take the same action. Low means a promotion has a large blast radius.",
   "gridPos": {
    "x": 4,
    "y": 43,
    "w": 5,
    "h": 5
   },
   "targets": [
    {
     "expr": "subscriber_shadow_agreement_rate{job=\"subscriber-api\"}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "yellow",
        "value": 0.7
       },
       {
        "color": "green",
        "value": 0.9
       }
      ]
     },
     "mappings": [
      {
       "type": "special",
       "options": {
        "match": "nan",
        "result": {
         "text": "no challenger",
         "color": "text",
         "index": 0
        }
       }
      },
      {
       "type": "special",
       "options": {
        "match": "null",
        "result": {
         "text": "no challenger",
         "color": "text",
         "index": 1
        }
       }
      }
     ]
    }
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "last"
     ],
     "fields": "",
     "values": false
    }
   }
  },
  {
   "type": "stat",
   "title": "Outreach volume change",
   "description": "Challenger flagged rate minus champion's. The operational cost the offline gate cannot see.",
   "gridPos": {
    "x": 9,
    "y": 43,
    "w": 5,
    "h": 5
   },
   "targets": [
    {
     "expr": "subscriber_shadow_flagged_rate_delta{job=\"subscriber-api\"}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "decimals": 2,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "yellow",
        "value": 0.05
       },
       {
        "color": "red",
        "value": 0.1
       }
      ]
     },
     "mappings": [
      {
       "type": "special",
       "options": {
        "match": "nan",
        "result": {
         "text": "no challenger",
         "color": "text",
         "index": 0
        }
       }
      },
      {
       "type": "special",
       "options": {
        "match": "null",
        "result": {
         "text": "no challenger",
         "color": "text",
         "index": 1
        }
       }
      }
     ]
    }
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "last"
     ],
     "fields": "",
     "values": false
    }
   }
  },
  {
   "type": "stat",
   "title": "Shadow errors",
   "description": "Batches the challenger failed on. Never affects a response \u2014 and must block a promotion.",
   "gridPos": {
    "x": 14,
    "y": 43,
    "w": 4,
    "h": 5
   },
   "targets": [
    {
     "expr": "sum(subscriber_shadow_errors_total)",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     }
    }
   }
  },
  {
   "type": "stat",
   "title": "Shadow cost (p95)",
   "description": "Latency the second model adds. Shadow scoring runs inline, so this is real.",
   "gridPos": {
    "x": 18,
    "y": 43,
    "w": 6,
    "h": 5
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.95, sum(rate(subscriber_shadow_latency_seconds_bucket[5m])) by (le))",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "decimals": 4
    }
   }
  },
  {
   "type": "timeseries",
   "title": "Comparisons per second, by agreement",
   "description": "Evidence accumulating. Agreement rates below a few hundred comparisons are noise dressed as a result.",
   "gridPos": {
    "x": 0,
    "y": 48,
    "w": 12,
    "h": 7
   },
   "targets": [
    {
     "expr": "sum by (agreed) (rate(subscriber_shadow_comparisons_total[5m]))",
     "legendFormat": "agreed={{agreed}}",
     "refId": "A"
    }
   ],
