# Keep the build context small and the image reproducible.
.git/
.github/
.venv/
venv/

# Secrets must never be baked into an image layer.
.env
.env.*

__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Data and artifacts are regenerated inside the build, never copied in.
src/data/raw/*.csv
src/data/processed/*.csv
src/data/*.db
*.sqlite
*.sqlite3
src/models/artifacts/*.joblib
src/models/artifacts/*.json

tests/
.idea/
.vscode/
.DS_Store
