# Python
__pycache__/
*.py[cod]
*.egg-info/
.Python
build/
dist/

# Virtual environments
.venv/
venv/
env/

# Secrets. Never commit these - the repository is public.
.env
.env.*
!.env.example

# Testing and tooling caches
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
coverage.xml

# Generated data and model artifacts.
# These are reproducible with `python -m src.models.train`, so they stay out of
# version control. The directories themselves are kept via .gitkeep.
src/data/raw/*.csv
src/data/processed/*.csv
src/data/*.db
*.sqlite
*.sqlite3
src/models/artifacts/*.joblib
src/models/artifacts/*.json

# ...except metrics.json, which DVC tracks in git rather than in its cache.
# A few kilobytes of JSON is worth committing when it makes `dvc metrics diff`
# able to answer "how did this change move ROC-AUC" across the history. The
# model itself stays out - that is what the DVC cache is for.
!src/models/artifacts/metrics.json

# Editors and OS
.idea/
.vscode/
.DS_Store
mlflow.db
mlruns/
.prefect/
prefect.db
src/models/artifacts/last_pipeline_run.json
